# AgentStream(LLM 판정 설명) 설정 예시. 실제 파일은 프로젝트 루트의 .env.agentstream(권한 600, Git·배포 묶음 제외)
# Key는 AgentStream 계정 설정 → API 연동에서 조직 대표가 발급한다. 저장소·로그·채팅에 남기지 않는다.
AGENTSTREAM_API_KEY=
# 챗봇 UUID(API 연동 → API 권한 매핑의 'ID 복사'). 챗봇은 공개, CHAT_INVOKE 권한 매핑 필요
AGENTSTREAM_CHATBOT_ID=
# 기본값 그대로면 비워 둔다
# AGENTSTREAM_BASE_URL=https://api-gateway.jntp-ax.or.kr/agentstream
# AGENTSTREAM_TIMEOUT=60
# AGENTSTREAM_MAX_CONCURRENT=1
# 지식베이스 문서를 다시 올렸으면 숫자를 올린다(예전 지식베이스로 만든 설명 캐시를 쓰지 않게)
# AGENTSTREAM_KB_VERSION=1
