# deploy/server.env 예시. 실제 주소는 AIStream 배포 관리 → 서빙 상세의 서비스 URL
export AISTREAM_URL=${AISTREAM_URL-https://aiopen-serving.jntp-ax.or.kr/<cpu|gpu>/SV-xxxxxxxx/predict}
export AISTREAM_FORMAT=${AISTREAM_FORMAT:-mlflow}
export AISTREAM_FAIL_THRESHOLD=${AISTREAM_FAIL_THRESHOLD:-0.175}
# 포장 사진 OCR 서빙(/predict). 없으면 사진 입력 칸이 숨겨진다
# export CERTCHECK_OCR_TIMEOUT=${CERTCHECK_OCR_TIMEOUT:-40}  # 공개 프록시 60초보다 짧게
# export CERTCHECK_OCR_URL=${CERTCHECK_OCR_URL-https://aiopen-serving.jntp-ax.or.kr/jntp-cpu/SV-xxxxxxxx/predict}
# 흐린 사진 기준(모델마다 다름. OCR 모델 버전 2 = rec4는 0.9·0.4, 버전 1 = rec2는 0.8·0.4)
# export CERTCHECK_OCR_LOW_CONF=${CERTCHECK_OCR_LOW_CONF:-0.9}
# export CERTCHECK_OCR_BLURRY_SHARE=${CERTCHECK_OCR_BLURRY_SHARE:-0.4}
